* {
    primary: #9bcaff;
    primary-fixed: #d0e4ff;
    primary-fixed-alpha: rgba(208, 228, 255, 0.2);
    primary-fixed-dim: #9bcaff;
    on-primary: #003256;
    on-primary-fixed: #001d35;
    on-primary-fixed-variant: #00497a;
    primary-container: #00497a;
    on-primary-container: #d0e4ff;
    secondary: #b8c6ea;
    secondary-fixed: #d8e2ff;
    secondary-fixed-dim: #b8c6ea;
    on-secondary: #22304c;
    on-secondary-fixed: #0c1b36;
    on-secondary-fixed-variant: #394664;
    secondary-container: #394664;
    on-secondary-container: #d8e2ff;
    tertiary: #bfc2fa;
    tertiary-fixed: #e0e0ff;
    tertiary-fixed-dim: #bfc2fa;
    on-tertiary: #282c5a;
    on-tertiary-fixed: #121644;
    on-tertiary-fixed-variant: #3e4372;
    tertiary-container: #3e4372;
    on-tertiary-container: #e0e0ff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0d141c;
    surface-alpha: rgba(13, 20, 28, 0.7);
    on-surface: #dde3ee;
    on-surface-variant: #c0c7d2;
    outline: #8b919b;
    outline-variant: #414750;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dde3ee;
    inverse-on-surface: #2a3139;
    inverse-primary: #0062a0;
    surface-dim: #0d141c;
    surface-bright: #333a42;
    surface-container-lowest: #080f16;
    surface-container-low: #151c24;
    surface-container: #192028;
    surface-container-high: #242b33;
    surface-container-highest: #2f353e;
}